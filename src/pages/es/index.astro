---
import { env } from 'cloudflare:workers';

import { getDb } from '../../db';
import Section from '../../features/home/components/section.astro';
import { getPublishedHome } from '../../features/home/server/queries';
import { listPublishedTeam } from '../../features/team/server/queries';
import { t } from '../../i18n';
import Site from '../../layouts/site.astro';

import type { HomeSection } from '../../features/home/shared/section-colors';

let home: Awaited<ReturnType<typeof getPublishedHome>> = null;
let team: Awaited<ReturnType<typeof listPublishedTeam>> = [];
let fallback = false;
let stale = false;
try {
  const db = getDb(env.DB);
  home = await getPublishedHome(db, 'es');
  team = await listPublishedTeam(db, 'es');
  fallback = !home;
  stale = (home?.stale ?? false) || team.some((member) => member.stale);
} catch {
  fallback = true;
}
const sections: HomeSection[] = home?.data.sections ?? [
  {
    id: 'fallback-hero',
    kind: 'hero',
    sortOrder: 0,
    hidden: false,
    heading: 'Driftlight',
    body: {
      type: 'doc',
      content: [
        {
          type: 'paragraph',
          content: [
            {
              type: 'text',
              text: 'Mantén a flote un faro. Ilumina una costa oscura, una señal a la vez, y descubre por qué se apagaron las luces.',
            },
          ],
        },
      ],
    },
    bgLight: 'paper',
    fgLight: 'ink',
    bgDark: 'night',
    fgDark: 'cream',
    items: [],
  },
];
---

<Site
  lang="es"
  title="Lumen — Estudio independiente"
  description="Lumen crea juegos con intención y un poco de luz."
>
  {fallback && (
    <p role="status" class="mx-auto max-w-7xl px-5 py-3 text-sm text-muted-foreground">
      {t('es', 'home.fallbackNotice')}
    </p>
  )}
  {stale && (
    <p role="status" class="mx-auto max-w-7xl px-5 py-3 text-sm text-muted-foreground">
      {t('es', 'home.staleNotice')}
    </p>
  )}
  {sections.map((section) => (
    <Section section={section} lang="es" team={team} />
  ))}
</Site>
