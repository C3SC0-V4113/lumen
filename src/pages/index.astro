---
import Logo from '../components/common/logo.astro';
import { t } from '../i18n';
import Layout from '../layouts/main.astro';
---

<Layout lang="en" surface="site" title="Lumen — Independent game studio">
  <Logo slot="brand" />
  <section class="mx-auto flex min-h-[65vh] max-w-6xl flex-col justify-center px-6 py-20">
    <p class="mb-4 text-sm font-medium tracking-wide text-primary">{t('en', 'home.eyebrow')}</p>
    <h1 class="max-w-3xl text-5xl leading-tight md:text-7xl">{t('en', 'home.title')}</h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
      {t('en', 'home.description')}
    </p>
  </section>
</Layout>
