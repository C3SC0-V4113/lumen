---
import { BeaconControl } from './beacon-control';
import RichText from '../../../components/common/rich-text.astro';
import { t, type Locale } from '../../../i18n';

import type { HomeSection } from '../shared/section-colors';
interface Props {
  section: HomeSection;
  lang: Locale;
  fallbackNotice?: boolean;
  staleNotice?: boolean;
}
const { section, lang, fallbackNotice = false, staleNotice = false } = Astro.props;
---

<section
  class="hero-scene relative isolate overflow-hidden px-5 pb-16 pt-32 text-foreground md:px-8 md:pt-40"
  aria-labelledby="home-title"
>
  <div class="hero-stars" aria-hidden="true"></div>
  <div class="hero-orb" aria-hidden="true">
    <svg class="hero-dots" viewBox="0 0 400 400">
      <defs>
        <pattern id="dots" width="9" height="9" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="1" fill="currentColor" />
        </pattern>
      </defs>
      <circle cx="200" cy="200" r="190" fill="url(#dots)" />
    </svg>
  </div>
  <div class="hero-art" aria-hidden="true">
    <div class="hero-beam">
      <span class="hero-beam-plane"></span>
      <span class="hero-beam-plane"></span>
      <span class="hero-beam-core"></span>
    </div>
    <div class="hero-flash"></div>
    <div class="hero-halo"></div>
    <div class="hero-wave hero-wave-a"></div>
    <div class="hero-wave hero-wave-b"></div>
    <div class="hero-wave hero-wave-c"></div>
  </div>
  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="max-w-2xl space-y-6">
      {fallbackNotice && (
        <p role="status" class="max-w-prose text-sm text-muted-foreground">
          {t(lang, 'home.fallbackNotice')}
        </p>
      )}
      {staleNotice && (
        <p role="status" class="max-w-prose text-sm text-muted-foreground">
          {t(lang, 'home.staleNotice')}
        </p>
      )}
      <p class="font-mono text-xs tracking-widest text-primary">{t(lang, 'home.gameEyebrow')}</p>
      <h1 id="home-title" class="font-heading text-6xl leading-none md:text-8xl">
        {section.heading ?? ''}
      </h1>
      {section.body && (
        <div class="max-w-prose space-y-4 text-lg leading-relaxed text-muted-foreground">
          <RichText value={section.body} />
        </div>
      )}
      <div class="flex flex-wrap gap-3">
        <a
          id="wishlist"
          class="rounded-lg bg-lamp px-5 py-3 font-semibold text-lamp-foreground"
          href="#wishlist"
        >
          {t(lang, 'home.wishlist')}
        </a>
        <a
          class="rounded-lg border border-border bg-background/50 px-5 py-3 font-semibold"
          href="#about"
        >
          {t(lang, 'home.demo')}
        </a>
      </div>
      <p class="text-sm text-muted-foreground">{t(lang, 'home.release')}</p>
    </div>
  </div>
  <BeaconControl client:load lang={lang} />
</section>
