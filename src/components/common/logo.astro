---
import { Sun } from 'lucide-react';

interface Props {
  label?: string;
  href?: string;
}

const { label = 'Lumen', href = '/' } = Astro.props;
---

<a
  href={href}
  aria-label={label}
  class="inline-flex items-center gap-3 font-heading text-xl font-semibold tracking-tight"
>
  <Sun aria-hidden="true" data-icon="inline-start" className="size-8 text-primary" />
  <span>{label}</span>
</a>
